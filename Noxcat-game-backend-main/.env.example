DATABASE_URL=postgres://noxcat:noxcat@localhost:5432/noxcat?sslmode=disable
TEST_DATABASE_URL=postgres://noxcat:noxcat@localhost:5432/noxcat_test?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=noxcat
HTTP_ADDRESS=:8080
# Optional: serve a built Vite app from the same Go process.
STATIC_DIR=
BATTLE_SESSION_TTL=2h
BATTLE_CLEANUP_INTERVAL=1m
BATTLE_CLEANUP_BATCH=100
SHUTDOWN_TIMEOUT=10s
DATABASE_CONNECT_TIMEOUT=10s
STARTING_MONEY=100
